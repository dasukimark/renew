<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.renew.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Renew.app/Contents/MacOS/Renew</string>
		<string>--background</string>
	</array>
